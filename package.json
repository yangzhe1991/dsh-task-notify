{
  "name": "@yangzhe1991/dsh-task-notify",
  "version": "0.2.0",
  "description": "[RETIRED] Merged into @yangzhe1991/dsh-web-enhance (0.2.0+) — this package is deprecated and receives no further updates. | [已停维护] 功能已并入 @yangzhe1991/dsh-web-enhance(0.2.0 起),本包已 deprecated、不再更新",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.zh.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepare": "node build.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/cordis",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-store": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-jobs": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-api-job-controller": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.7-rc.2",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}
